# seeed-local-voice reference environment.
# Copy to `.env` next to docker-compose.yml and edit for your host.

# Profile selection (Jetson Orin NX, qwen3 ASR + matcha TTS — verified working).
SEEED_LOCAL_VOICE_PROFILE=jetson-qwen3asr-matcha-nx
OVS_PROFILE=jetson-qwen3asr-matcha-nx
LANGUAGE_MODE=multilanguage

# Memory cap. 6G is the validated value for Orin NX 16GB.
SEEED_LOCAL_VOICE_MEMORY_LIMIT=6G
OVS_MEMORY_LIMIT=6G

# China-mainland mirror; remove or set to https://huggingface.co outside CN.
HF_ENDPOINT=https://hf-mirror.com

# ASR streaming mode.
EDGE_LLM_ASR_STREAM_MODE=accumulate

# REPLACE with a random 32-char hex secret (used by the OVS admin API).
# Generate with: openssl rand -hex 16
OVS_ADMIN_KEY=REPLACE_WITH_RANDOM_HEX

# VAD tuning.
OVS_VAD_BACKEND=silero
OVS_VAD_SILENCE_MS=400

# TTS tuning (matcha defaults).
TTS_DEFAULT_SPEED=0.85
TTS_DEFAULT_SID=0
TTS_PROVIDER=cuda
TTS_NUM_THREADS=4

# Streaming ASR (cuda backend).
STREAMING_ASR_PROVIDER=cuda
STREAMING_ASR_NUM_THREADS=4
CUDA_MODULE_LOADING=LAZY
PARAFORMER_PREROLL_MS=100

# Matcha CJK segmentation.
EDGE_LLM_TTS_CJK_SEGMENT_MAX_CHARS=16

# Qwen3 EdgeLLM artifact paths (inside the container).
QWEN3_ARTIFACT_ROOT=/opt/models/qwen3-edgellm
QWEN3_EDGELLM_JETSON_ROOT=/opt/qwen3-edgellm-jetson
QWEN3_HF_REVISION=main
