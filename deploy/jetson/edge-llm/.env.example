# edge-llm-chat-service reference environment.
# Copy to `.env` next to docker-compose.yml and edit for your host.

# Image — change to your local build tag if not using the published image.
EDGE_LLM_IMAGE=sensecraft-missionpack.seeed.cn/solution/edge-llm-chat-service:latest

# Engine selection. Commit pin must match the TensorRT engine artifacts in
# the workspace; mismatch will cause the runtime to re-download.
EDGELLM_ENGINE_REPO=harvestsu/Qwen3-4B-AWQ-TensorRT-EdgeLLM-engine
EDGELLM_ENGINE_REVISION=main
EDGELLM_EXPECTED_ENGINE_COMMIT=7d6579c8293c5cc62986238aa200ea9c7b57d50a
EDGELLM_EXPECTED_TENSORRT=10.3.0.30

WARMUP_TIMEOUT=90
WARMUP_INFERENCE_TIMEOUT=180

# Persistent workspace holds the downloaded engine + tokenizer (~5GB).
# Replace `<user>` with the host user that owns the directory.
EDGELLM_WORKSPACE=/home/<user>/edgellm-workspace

# China-mainland mirror; remove or set to https://huggingface.co outside CN.
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ENDPOINT=https://hf-mirror.com
