# edge-llm-chat-service reference environment.
# Copy to `.env` next to docker-compose.yml and edit for your host.

# Image — change to your local build tag if not using the published image.
EDGE_LLM_IMAGE=sensecraft-missionpack.seeed.cn/solution/edge-llm-chat-service:v0.8.0-gdn-mtp-fixdl

# Engine selection — Qwen3.5-4B-AWQ GDN + MTP. Auto-downloads from HF into the
# workspace on first boot; this repo ships no provenance file so the compose
# sets EDGELLM_SKIP_ENGINE_PROVENANCE_CHECK=1.
EDGELLM_ENGINE_REPO=harvestsu/Qwen3.5-4B-AWQ-GDN-MTP-TensorRT-EdgeLLM-engine
EDGELLM_ENGINE_REVISION=main

WARMUP_TIMEOUT=180
WARMUP_INFERENCE_TIMEOUT=300

# Persistent workspace holds the downloaded engine + tokenizer (~4.6GB for the
# Qwen3.5 GDN+MTP bundle). Replace `<user>` with the host user that owns it.
EDGELLM_WORKSPACE=/home/<user>/edgellm-workspace

# China-mainland mirror; remove or set to https://huggingface.co outside CN.
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ENDPOINT=https://hf-mirror.com
