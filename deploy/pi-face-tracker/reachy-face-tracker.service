[Unit]
Description=Reachy Mini face tracking bridge
After=network-online.target reachy-mini-daemon-local.service vision-hailo.service
Wants=network-online.target reachy-mini-daemon-local.service vision-hailo.service
Requires=reachy-mini-daemon-local.service

[Service]
Type=simple
User=recomputer
WorkingDirectory=/home/recomputer/reachy-claw
Environment=HOME=/home/recomputer
Environment=PYTHONPATH=/home/recomputer/reachy-claw/src
Environment=REACHY_DAEMON_HOST=127.0.0.1
Environment=REACHY_DAEMON_PORT=8000
Environment=REACHY_VISION_URL=tcp://127.0.0.1:8631
ExecStart=/home/recomputer/reachy_mini_conversation_app/.venv/bin/python /home/recomputer/reachy-claw/deploy/pi-face-tracker/face_tracker.py
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
